# =================================================================
# Halloween Doorcam Configuration
# =================================================================

# --- Camera Configuration ---
# Video device path (using video2) or camera index
CAMERA_DEVICE=/dev/video2

# --- Local Ollama Server Configuration ---
# Local Ollama endpoint accessible from within Docker container
# 'host.docker.internal' points back to the host machine where Ollama is running
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- Whisper Speech-to-Text Model ---
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# --- Text-to-Speech (Edge-TTS) Configuration ---
# Voices: en-GB-RyanNeural (spooky British gargoyle), en-US-ChristopherNeural, etc.
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=-15%
TTS_PITCH=-50Hz

# --- Motion Detection Sensitivity & Timing ---
# Minimum contour area in pixels to trigger interaction (lower = more sensitive)
MOTION_THRESHOLD=5000
# Cooldown period (seconds) after an interaction before detecting motion again
MOTION_COOLDOWN=15

# --- Speech Recognition Timing & Sensitivity ---
# Ambient background noise calibration duration in seconds
AMBIENT_NOISE_DURATION=0.8
# Seconds to wait for child to begin speaking
LISTEN_TIMEOUT=8
# Maximum allowed duration in seconds for child's response phrase
LISTEN_PHRASE_TIME_LIMIT=15
# Seconds of silence after speaking before ending recording (prevents cutting off)
PAUSE_THRESHOLD=2.0
# Sensitivity threshold (lower = more sensitive to quiet children, 200-400 recommended)
ENERGY_THRESHOLD=300
# Keep sensitivity fixed instead of drifting higher with background noise
DYNAMIC_ENERGY_THRESHOLD=false
# Delay in seconds after speaker dialogue finishes before opening mic (prevents echo)
PRE_LISTEN_DELAY=0.8

# --- Spooky Dialogue & Riddle Settings ---
RIDDLES_FILE=riddles.txt
RIDDLE_PROMPT=You are a spooky Halloween gargoyle. Ask a very short, simple Halloween riddle for a child. Do not include the answer in your response.
CORRECT_ANSWER_MESSAGE=You are clever, mortal. You may take a sweet from the bowl.
WRONG_ANSWER_MESSAGE=Wrong! The answer was {answer}. But because you wear such a scary costume, you may take a sweet from the bowl anyway!
SILENT_ANSWER_MESSAGE=You are silent! The answer was {answer}. But because you wear such a scary costume, you may take a sweet from the bowl!

# --- Camera Device Metadata ---
CAMERA_NAME=UGREEN Camera

# --- Bluetooth & Audio Configuration ---
BLUETOOTH_AUDIO_MAC=4C:3C:8F:93:76:CE
AUDIO_OUTPUT_DEVICE=JBL Clip 5
BLUETOOTH_AUDIO_NAME=JBL Clip 5
PULSE_SOCKET=/run/user/1000/pulse/native
AUDIO_INPUT_DEVICE=Wireless Microphone Analog Stereo
PULSE_SERVER=unix:/tmp/pulse-socket

# --- Halloween Sound Effects (AudioCraft & FX Engine) ---
ENABLE_SOUND_EFFECTS=true
FX_MOTION_DETECTED=motion_detected
FX_RIDDLE_INTRO=riddle_intro
FX_CORRECT_ANSWER=correct_answer
FX_WRONG_ANSWER=wrong_answer
FX_SILENT_ANSWER=silence_ghost

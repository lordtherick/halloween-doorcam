# =================================================================
# Halloween Doorcam Configuration Template
# =================================================================

# --- Camera Configuration ---
CAMERA_DEVICE=/dev/video2
CAMERA_NAME=ASUS FHD webcam

# --- Bluetooth & Audio Configuration ---
BLUETOOTH_AUDIO_NAME=soundcore Space Q45
BLUETOOTH_AUDIO_MAC=E8:EE:CC:6F:DF:C3
AUDIO_OUTPUT_DEVICE=soundcore Space Q45
AUDIO_INPUT_DEVICE=soundcore Space Q45
PULSE_SERVER=unix:/tmp/pulse-socket
PULSE_SOCKET=/run/user/1000/pulse/native

# --- Local Ollama Server Configuration ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- Whisper Speech-to-Text Model ---
WHISPER_MODEL=base

# --- Text-to-Speech (Edge-TTS) Configuration ---
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=-10%
TTS_PITCH=-15Hz

# --- Motion Detection Sensitivity & Timing ---
MOTION_THRESHOLD=5000
MOTION_COOLDOWN=15
MOTION_LOG_INTERVAL=2.0
SAVE_DETECTED_FRAMES=true
DETECTED_FRAMES_DIR=detected_frames

# --- Speech Recognition Timing & Sensitivity ---
AMBIENT_NOISE_DURATION=0.2
LISTEN_TIMEOUT=8
LISTEN_PHRASE_TIME_LIMIT=15
PAUSE_THRESHOLD=2.0
ENERGY_THRESHOLD=300
DYNAMIC_ENERGY_THRESHOLD=false
PRE_LISTEN_DELAY=0.2

# --- Spooky Dialogue & Riddle Settings ---
GREETINGS_FILE=greetings.txt
RIDDLES_FILE=riddles.txt
RIDDLE_PROMPT=You are a spooky Halloween skeleton. Ask a very short, simple Halloween riddle for a child. Do not include the answer in your response.
CORRECT_ANSWER_MESSAGE=Clickity-clack! You are clever, mortal! You tickled my funny bone—you may take a sweet from the bowl!
WRONG_ANSWER_MESSAGE=Rattle my ribs, not quite! The answer was {answer}. But because you wear such a scary costume, you may take a sweet from the bowl anyway!
GIVE_UP_ANSWER_MESSAGE=Stumped your hollow skull, did I? Clickity-clack! The answer was {answer}. Because you wear such a scary costume, you may take a sweet from the bowl anyway!
SILENT_ANSWER_MESSAGE=Cat got your tongue, or did my rattling bones scare you? The answer was {answer}. Because you wear such a scary costume, you may take a sweet from the bowl!

# --- Halloween Sound Effects (AudioCraft & FX Engine) ---
ENABLE_SOUND_EFFECTS=true
FX_MOTION_DETECTED=motion_detected
FX_RIDDLE_INTRO=riddle_intro
FX_CORRECT_ANSWER=correct_answer
FX_WRONG_ANSWER=wrong_answer
FX_SILENT_ANSWER=silence_ghost

# --- Skeleton Service Configuration ---
SKELETON_GREETINGS_FILE=skeleton_greetings.txt
SKELETON_TTS_VOICE=en-GB-RyanNeural
SKELETON_TTS_RATE=-5%
SKELETON_TTS_PITCH=-20Hz
FX_SKELETON_MOTION=chains
SKELETON_TREAT_MESSAGE=You may take a treat from the bowl! Happy Halloween!
SKELETON_SILENT_MESSAGE=Cat got your tongue? Or maybe a ghost! That is okay, my rattled friend, you can still take a treat from the bowl! Happy Halloween!
